# Python AI Lab - Environment Configuration Template
# Copy this file to .env for local testing

# OpenAI Configuration
OPENAI_API_KEY=mock-api-key-for-testing
OPENAI_MODEL=gemma-4-e4b-it
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3

# Application Environment
ENV=dev
DEBUG=true

# Database Configuration (Optional for PostgreSQL/pgvector tracks)
DB__HOST=localhost
DB__PORT=5432
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=ai_lab
